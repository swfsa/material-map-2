# Real poc4 data is the default. Keep this false for integration verification.
VITE_USE_MOCK_ENERGY=false

# Leave empty when using the Vite /api proxy. Set an absolute URL only when the
# frontend and backend are served from different origins.
VITE_API_BASE_URL=

# Optional fixed lower bound for the WTI chart. Default: one year before today.
VITE_EIA_PERIOD_FROM=2025-08-05
