# Copy this file to .env and fill in your own values.
#
# Active LLM provider. Switching among configured profiles usually only requires
# changing this value: deepseek | mimo | bailian | openai | any custom name.
LLM_PROVIDER=deepseek
LLM_API_STYLE=openai

# Optional global overrides. Leave blank to use the active provider's own values.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# DeepSeek profile.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Xiaomi MiMo supports both protocols with the same profile credentials.
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro
MIMO_OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ANTHROPIC_BASE_URL=https://api.xiaomimimo.com/anthropic

# Native Anthropic API profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Alibaba Cloud Model Studio (Bailian), Beijing public endpoint.
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen-plus
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Any future OpenAI-compatible provider works without a code change:
# LLM_PROVIDER=my_provider
# MY_PROVIDER_API_KEY=
# MY_PROVIDER_MODEL=
# MY_PROVIDER_OPENAI_BASE_URL=https://example.com/v1
# MY_PROVIDER_ANTHROPIC_BASE_URL=https://example.com/anthropic

DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/material_intelligence
LOG_LEVEL=INFO

# Web Search: Tavily is the default provider; DDGS remains available as fallback.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_SEARCH_TOPIC=general
WEB_SEARCH_TIMEOUT=30
TAVILY_MAX_RETRIES=1
TAVILY_RETRY_DELAY=1

# Only used when WEB_SEARCH_PROVIDER=ddgs.
WEB_SEARCH_REGION=wt-wt
WEB_SEARCH_SAFESEARCH=moderate
WEB_SEARCH_BACKEND=auto
